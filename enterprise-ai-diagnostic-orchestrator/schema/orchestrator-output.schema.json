{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise AI Diagnostic Scheduling Proposal v0.1",
  "type": "object",
  "required": [
    "contract_type", "contract_version", "event_id", "decision", "target",
    "reason_codes", "human_summary", "context_package", "human_task",
    "proposed_state_change", "next_expected_events", "write_authority", "created_at"
  ],
  "properties": {
    "contract_type": {"const": "enterprise_ai_diagnostic_scheduling_proposal"},
    "contract_version": {"const": "0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["invoke_skill", "wait_external", "request_human", "pause", "no_action"]},
    "target": {"type": ["string", "null"]},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "human_summary": {"type": "string", "minLength": 1},
    "context_package": {"type": "object"},
    "human_task": {"type": ["object", "null"]},
    "proposed_state_change": {"type": "object"},
    "next_expected_events": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "write_authority": {"const": "scheduling_proposal"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

