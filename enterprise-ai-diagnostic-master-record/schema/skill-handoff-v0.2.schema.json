{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise AI Diagnostic Skill Handoff v0.2",
  "type": "object",
  "required": [
    "contract_type", "contract_version", "handoff_id", "producer_skill",
    "event_type", "handoff_status", "write_authority", "routing_context",
    "records_to_register", "participant_task_updates", "unresolved_items",
    "missing_registration_fields", "created_at"
  ],
  "properties": {
    "contract_type": {"const": "enterprise_ai_diagnostic_skill_handoff"},
    "contract_version": {"const": "0.2"},
    "handoff_id": {"type": "string", "minLength": 1},
    "producer_skill": {
      "enum": [
        "enterprise-workflow-mapping",
        "enterprise-material-analysis",
        "enterprise-ai-process-diagnosis"
      ]
    },
    "event_type": {
      "enum": [
        "workflow_card_confirmed", "workflow_card_declined",
        "material_analysis_completed", "material_analysis_blocked",
        "process_diagnosis_completed", "process_diagnosis_blocked"
      ]
    },
    "handoff_status": {"enum": ["ready_for_registration", "needs_registration_context", "blocked_by_evidence"]},
    "write_authority": {"const": "registration_proposal"},
    "routing_context": {"$ref": "#/$defs/routingContext"},
    "records_to_register": {"type": "array", "items": {"$ref": "#/$defs/recordProposal"}},
    "participant_task_updates": {"type": "array", "items": {"$ref": "#/$defs/taskUpdate"}},
    "unresolved_items": {"type": "array", "items": {"$ref": "#/$defs/unresolvedItem"}},
    "missing_registration_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "routingContext": {
      "type": "object",
      "required": ["enterprise_id", "project_id", "process_id"],
      "properties": {
        "enterprise_id": {"type": ["string", "null"]},
        "project_id": {"type": ["string", "null"]},
        "process_id": {"type": ["string", "null"]},
        "participant_id": {"type": ["string", "null"]},
        "department_id": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "task_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "recordProposal": {
      "type": "object",
      "required": ["collection", "record"],
      "properties": {
        "collection": {"enum": ["workflow_cards", "materials", "conflicts_and_evidence_requests", "organizational_confirmations", "diagnoses_and_pilots"]},
        "record": {
          "type": "object",
          "required": ["record_id", "record_type", "version", "lifecycle_status", "enterprise_id", "project_id", "authorization_status", "upstream_records", "supersedes", "change_reason", "storage_ref", "created_at", "created_by_role"],
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "taskUpdate": {
      "type": "object",
      "required": ["task_id", "status", "status_reason"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["awaiting_employee_confirmation", "confirmed", "participant_declined", "completed"]},
        "current_workflow_card": {"type": "string", "pattern": "^[^@]+@[1-9][0-9]*$"},
        "status_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unresolvedItem": {
      "type": "object",
      "required": ["item_id", "kind", "blocking", "source_records", "summary"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["open_question", "conflict", "evidence_gap", "registration_context"]},
        "blocking": {"type": "boolean"},
        "source_records": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "string", "minLength": 1},
        "suggested_exception_level": {"enum": ["A0", "A1", "H1", "H2", "S0"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
