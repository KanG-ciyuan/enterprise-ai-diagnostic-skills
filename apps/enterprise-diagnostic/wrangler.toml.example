# Copy to wrangler.toml for local development.
# This is a local-only example. Do not commit real Cloudflare resource IDs.
name = "enterprise-ai-diagnostic-local"
compatibility_date = "2026-08-21"
pages_build_output_dir = "./dist"

[vars]
FORMAL_APP_ORIGIN = "http://127.0.0.1:8788"
# development enables local-only demo/test authentication paths.
# Never use this configuration for a public deployment.
FORMAL_AUTH_MODE = "development"
FORMAL_AUTH_TEST_MODE = "1"

[[d1_databases]]
binding = "DB"
database_name = "enterprise-diagnostic-local"
# Dummy UUID for local wrangler; replace with your own D1 id if deploying remote.
database_id = "00000000-0000-0000-0000-000000000000"

# Optional: queue binding is only needed for authorization-confirmation features.
# [[queues.producers]]
# binding = "AUTHORIZATION_CONFIRMATION_QUEUE"
# queue = "enterprise-authorization-confirmations-local"
